{
  "manifest_version": 3,

  "name": "CF FastTrack",

  "version": "1.0",

  "description": "Instantly open Codeforces problems using problem codes like 1008A.",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },

  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },

  "permissions": ["tabs"]
}