{
  "manifest_version": 3,
  "name": "CF FastTrack",
  "version": "1.1",
  "description": "Find and instantly open Codeforces problems by code or name.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["tabs"]
}